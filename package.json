{
  "name": "portfolio-pulse",
  "version": "0.4.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Local-first Indian portfolio tracker, multi-broker MCP reconciler (INDmoney + Upstox), daily audit notifier, and BYOK AI advisor.",
  "author": "Portfolio Pulse Contributors",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:mac": "npm run build && electron-builder --mac --publish never",
    "pack:win": "npm run build && electron-builder --win --publish never",
    "pack:all": "npm run build && electron-builder --mac --win --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "lucide-react": "^0.475.0",
    "recharts": "^2.15.1",
    "sql.js": "^1.12.0",
    "unpdf": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "postcss": "^8.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
